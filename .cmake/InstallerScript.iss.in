; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyAppName "${PROJECT_APP_NAME}"
#define MyAppVersion "${PROJECT_VERSION}"
#define MyAppBuildDate GetDateTimeString("yyyymmdd", "", "")
#define MyAppPublisher "${PROJECT_COMPANY}"
#define MyAppURL "${PROJECT_DOMAIN}"
#define MyAppExeName "${PROJECT_APP_NAME}.exe"
#define MyAppFileDir "dist"
#define VCRuntimeVersion GetVersionNumbersString(AddBackslash(SourcePath) + "..\" + MyAppFileDir + "\vc_redist.x64.exe")

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{A053D1AE-AEA9-4105-B79C-B5F5BEDC9208}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={commonpf64}\{#MyAppName}
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
DisableProgramGroupPage=yes
RestartApplications=no
ChangesAssociations=yes
; Uncomment the following line to run in non administrative install mode (install for current user only.)
;PrivilegesRequired=lowest
OutputDir=.\
OutputBaseFilename={#MyAppName}-{#MyAppVersion}-{#MyAppBuildDate}
Compression=lzma
SolidCompression=yes
WizardStyle=modern
UninstallDisplayIcon={app}\{#MyAppExeName}
SetupIconFile=${APP_ICON}
MinVersion=10.0.17763

[Languages]
Name: "chinesesimplified"; MessagesFile: "compiler:Languages\ChineseSimplified.isl"

[Tasks]
Name: "settingsreset"; Description: "全新安装（重置全部设置）"; GroupDescription: "安装方式："; Flags: exclusive
Name: "settingskeep"; Description: "覆盖安装（保留全部设置）"; GroupDescription: "安装方式："; Flags: exclusive unchecked
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: checkablealone

[Registry]
; Advertise handlers without changing extension defaults or UserChoice.
Root: HKA; Subkey: "Software\Classes\GPlatform.STL"; ValueType: string; ValueData: "GPlatform stl"
Root: HKA; Subkey: "Software\Classes\GPlatform.STL\DefaultIcon"; ValueType: string; ValueData: "{app}\{#MyAppExeName},0"
Root: HKA; Subkey: "Software\Classes\GPlatform.STL\shell\open\command"; ValueType: string; ValueData: """{app}\{#MyAppExeName}"" ""%1"""
Root: HKA; Subkey: "Software\Classes\.stl\OpenWithProgids"; ValueType: string; ValueName: "GPlatform.STL"; ValueData: ""
Root: HKA; Subkey: "Software\GPlatform\Capabilities\FileAssociations"; ValueType: string; ValueName: ".stl"; ValueData: "GPlatform.STL"
Root: HKA; Subkey: "Software\Classes\GPlatform.3MF"; ValueType: string; ValueData: "GPlatform 3mf"
Root: HKA; Subkey: "Software\Classes\GPlatform.3MF\DefaultIcon"; ValueType: string; ValueData: "{app}\{#MyAppExeName},0"
Root: HKA; Subkey: "Software\Classes\GPlatform.3MF\shell\open\command"; ValueType: string; ValueData: """{app}\{#MyAppExeName}"" ""%1"""
Root: HKA; Subkey: "Software\Classes\.3mf\OpenWithProgids"; ValueType: string; ValueName: "GPlatform.3MF"; ValueData: ""
Root: HKA; Subkey: "Software\GPlatform\Capabilities\FileAssociations"; ValueType: string; ValueName: ".3mf"; ValueData: "GPlatform.3MF"
Root: HKA; Subkey: "Software\Classes\GPlatform.GCode"; ValueType: string; ValueData: "GPlatform gcode"
Root: HKA; Subkey: "Software\Classes\GPlatform.GCode\DefaultIcon"; ValueType: string; ValueData: "{app}\{#MyAppExeName},0"
Root: HKA; Subkey: "Software\Classes\GPlatform.GCode\shell\open\command"; ValueType: string; ValueData: """{app}\{#MyAppExeName}"" ""%1"""
Root: HKA; Subkey: "Software\Classes\.gcode\OpenWithProgids"; ValueType: string; ValueName: "GPlatform.GCode"; ValueData: ""
Root: HKA; Subkey: "Software\GPlatform\Capabilities\FileAssociations"; ValueType: string; ValueName: ".gcode"; ValueData: "GPlatform.GCode"
Root: HKA; Subkey: "Software\Classes\gplatform"; ValueType: string; ValueData: "URL:GPlatform Open"
Root: HKA; Subkey: "Software\Classes\gplatform"; ValueType: string; ValueName: "URL Protocol"; ValueData: ""
Root: HKA; Subkey: "Software\Classes\gplatform\shell\open\command"; ValueType: string; ValueData: """{app}\{#MyAppExeName}"" ""%1"""
Root: HKA; Subkey: "Software\GPlatform\Capabilities"; ValueType: string; ValueName: "ApplicationName"; ValueData: "GPlatform"
Root: HKA; Subkey: "Software\GPlatform\Capabilities"; ValueType: string; ValueName: "ApplicationDescription"; ValueData: "Open STL and 3MF models and preview G-code in GPlatform."
Root: HKA; Subkey: "Software\GPlatform\Capabilities"; ValueType: string; ValueName: "ApplicationIcon"; ValueData: "{app}\{#MyAppExeName},0"
Root: HKA; Subkey: "Software\GPlatform\Capabilities\URLAssociations"; ValueType: string; ValueName: "gplatform"; ValueData: "gplatform"
Root: HKA; Subkey: "Software\RegisteredApplications"; ValueType: string; ValueName: "GPlatform"; ValueData: "Software\GPlatform\Capabilities"

[Files]
; Extract prerequisites before the application files in this solid-compressed archive.
Source: ".\..\{#MyAppFileDir}\vc_redist.x64.exe"; Flags: dontcopy
Source: ".\..\{#MyAppFileDir}\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
Source: "${CMAKE_CURRENT_SOURCE_DIR}/config/GPlatform.defaults.ini"; DestDir: "{app}"; Flags: ignoreversion
Source: ".\..\{#MyAppFileDir}\*"; DestDir: "{app}"; Excludes: "{#MyAppExeName},vc_redist.x64.exe"; Flags: ignoreversion recursesubdirs createallsubdirs
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

[Code]
var
  VCRuntimeRestartRequired: Boolean;
  DefaultSettingsTasks: String;

const
  UserSettingsDir = '%LOCALAPPDATA%\{#MyAppName}\{#MyAppName}';
  UserSettingsFile = UserSettingsDir + '\{#MyAppName}.ini';

function RunUserSettingsCommand(const Command, WorkingDir: String;
  var ExitCode: Integer): Boolean;
begin
  { Resolve LOCALAPPDATA in the original user's process, not the elevated installer. }
  Result := ExecAsOriginalUser(ExpandConstant('{cmd}'),
    '/D /E:ON /V:OFF /S /C "' + Command + '"', WorkingDir,
    SW_HIDE, ewWaitUntilTerminated, ExitCode);
end;

procedure InitializeWizard;
var
  ExitCode: Integer;
  RequestedTasks: String;
begin
  if not RunUserSettingsCommand(
    '(if not defined LOCALAPPDATA exit /b 2) & if exist "' +
    UserSettingsFile + '" (exit /b 0) else (exit /b 1)',
    ExpandConstant('{sys}'), ExitCode) then
    RaiseException(Format('无法检查安装用户的配置文件（错误 %d）。', [ExitCode]));
  if (ExitCode <> 0) and (ExitCode <> 1) then
    RaiseException(Format('无法确定安装用户的配置目录（返回值 %d）。', [ExitCode]));

  { Do not inherit a previous reset choice; explicit standard /TASKS takes precedence. }
  RequestedTasks := Lowercase(ExpandConstant('{param:TASKS|}') + ',' +
    ExpandConstant('{param:MERGETASKS|}'));
  if (Pos('settingsreset', RequestedTasks) = 0) and
     (Pos('settingskeep', RequestedTasks) = 0) then
  begin
    if ExitCode = 0 then
      DefaultSettingsTasks := '!settingsreset,settingskeep'
    else
      DefaultSettingsTasks := '!settingskeep,settingsreset';
  end;
end;

procedure CurPageChanged(CurPageID: Integer);
begin
  { Task controls are created on page entry; apply defaults once, preserving user edits. }
  if (CurPageID = wpSelectTasks) and (DefaultSettingsTasks <> '') then
  begin
    WizardSelectTasks(DefaultSettingsTasks);
    DefaultSettingsTasks := '';
  end;
end;

procedure CurStepChanged(CurStep: TSetupStep);
var
  ExitCode: Integer;
begin
  if CurStep <> ssPostInstall then
    Exit;
  if WizardIsTaskSelected('settingskeep') then
  begin
    Log('Settings mode: preserve; user INI is left untouched');
    Exit;
  end;

  { WorkingDir passes the install path without embedding it in shell command text. }
  if not RunUserSettingsCommand(
    '(if not defined LOCALAPPDATA exit /b 2) & (if not exist "' +
    UserSettingsDir + '" mkdir "' + UserSettingsDir +
    '") & (if not exist "' + UserSettingsDir +
    '" exit /b 3) & copy /B /Y "GPlatform.defaults.ini" "' +
    UserSettingsFile + '" >nul && "%SystemRoot%\System32\fc.exe" /B ' +
    '"GPlatform.defaults.ini" "' + UserSettingsFile + '" >nul',
    ExpandConstant('{app}'), ExitCode) then
    RaiseException(Format('无法重置安装用户的配置文件（错误 %d）。', [ExitCode]));
  if ExitCode <> 0 then
    RaiseException(Format('配置文件重置失败（返回值 %d）。', [ExitCode]));
  Log('Settings mode: reset; complete default INI copied for the original user');
end;

function VCRuntimeNeeded: Boolean;
var
  Installed: Cardinal;
  Version: String;
  InstalledVersion, RequiredVersion: Int64;
begin
  Result := True;
  if not RegQueryDWordValue(HKLM64,
    'SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64', 'Installed', Installed) then
    Exit;
  if Installed <> 1 then
    Exit;
  if not RegQueryStringValue(HKLM64,
    'SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64', 'Version', Version) then
    Exit;
  if Copy(Version, 1, 1) = 'v' then
    Delete(Version, 1, 1);
  if not StrToVersion(Version, InstalledVersion) or
     not StrToVersion('{#VCRuntimeVersion}', RequiredVersion) then
    Exit;
  Result := ComparePackedVersion(InstalledVersion, RequiredVersion) < 0;
  Log(Format('VC runtime: installed=%s required=%s', [Version, '{#VCRuntimeVersion}']));
end;

function PrepareToInstall(var NeedsRestart: Boolean): String;
var
  ExitCode: Integer;
begin
  Result := '';
  if WizardIsTaskSelected('settingsreset') = WizardIsTaskSelected('settingskeep') then
  begin
    Result := '请选择一种安装方式：全新安装或覆盖安装。';
    Exit;
  end;
  if not VCRuntimeNeeded then
  begin
    Log('VC runtime prerequisite satisfied; skipping installation');
    Exit;
  end;
  Log('Installing bundled VC runtime prerequisite');
  ExtractTemporaryFile('vc_redist.x64.exe');
  if not Exec(ExpandConstant('{tmp}\vc_redist.x64.exe'),
    '/install /quiet /norestart', '', SW_HIDE, ewWaitUntilTerminated, ExitCode) then
  begin
    Result := Format('无法启动 Microsoft Visual C++ 运行时安装程序（错误 %d）。', [ExitCode]);
    Exit;
  end;
  Log(Format('VC runtime installer exit code: %d', [ExitCode]));
  VCRuntimeRestartRequired := ExitCode = 3010;
  if ((ExitCode <> 0) and (ExitCode <> 3010) and (ExitCode <> 1638)) or
     VCRuntimeNeeded then
    Result := Format('Microsoft Visual C++ 运行时安装未完成（返回值 %d）。', [ExitCode]);
end;

function NeedRestart: Boolean;
begin
  Result := VCRuntimeRestartRequired;
end;


{ Remove only associations whose current command still belongs to this install. }
procedure RemoveOwnedHandler(RootKey: Integer; const ProgId, Extension, Expected: String);
var Command: String;
begin
  if RegQueryStringValue(RootKey, 'Software\Classes\' + ProgId + '\shell\open\command', '', Command)
     and (CompareText(Command, Expected) = 0) then
  begin
    if Extension <> '' then
      RegDeleteValue(RootKey, 'Software\Classes\.' + Extension + '\OpenWithProgids', ProgId);
    RegDeleteKeyIncludingSubkeys(RootKey, 'Software\Classes\' + ProgId);
  end;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var RootKey: Integer; Expected, Icon, Registered: String;
begin
  if CurUninstallStep <> usUninstall then Exit;
  if IsAdminInstallMode then RootKey := HKLM64 else RootKey := HKCU;
  Expected := '"' + ExpandConstant('{app}\{#MyAppExeName}') + '" "%1"';
  RemoveOwnedHandler(RootKey, 'GPlatform.STL', 'stl', Expected);
  RemoveOwnedHandler(RootKey, 'GPlatform.3MF', '3mf', Expected);
  RemoveOwnedHandler(RootKey, 'GPlatform.GCode', 'gcode', Expected);
  RemoveOwnedHandler(RootKey, 'gplatform', '', Expected);
  if RegQueryStringValue(RootKey, 'Software\GPlatform\Capabilities', 'ApplicationIcon', Icon)
     and (CompareText(Icon, ExpandConstant('{app}\{#MyAppExeName},0')) = 0) then
  begin
    RegDeleteKeyIncludingSubkeys(RootKey, 'Software\GPlatform\Capabilities');
    if RegQueryStringValue(RootKey, 'Software\RegisteredApplications', 'GPlatform', Registered)
       and (Registered = 'Software\GPlatform\Capabilities') then
      RegDeleteValue(RootKey, 'Software\RegisteredApplications', 'GPlatform');
  end;
end;
