[Desktop Entry]
Type=Application
Name=${PROJECT_APP_NAME}
Exec="/opt/${PROJECT_APP_NAME}/${PROJECT_APP_NAME}" %U
Icon=/opt/${PROJECT_APP_NAME}/${PROJECT_APP_NAME}.png
Comment=${PROJECT_DESCRIPTION}
Terminal=false
MimeType=model/stl;model/3mf;application/vnd.ms-3mfdocument;text/x.gcode;x-scheme-handler/gplatform;
Categories=Graphics;3DGraphics;
