include_guard(GLOBAL)
set(_GPLATFORM_BUILD_CMAKE_DIR "${CMAKE_CURRENT_LIST_DIR}")

# Shared by the source project and the exported App. Standard tool overrides
# are passed to CMake; each dependency discovers tools when it needs them.
foreach(_input GPLATFORM_TARGET_ARCH CMAKE_TOOLCHAIN_FILE
        CMAKE_C_COMPILER CMAKE_CXX_COMPILER CMAKE_MAKE_PROGRAM
        Python3_EXECUTABLE GIT_EXECUTABLE PERL_EXECUTABLE)
    if(NOT DEFINED ${_input} AND DEFINED ENV{${_input}} AND NOT "$ENV{${_input}}" STREQUAL "")
        set(${_input} "$ENV{${_input}}" CACHE STRING "Build input: ${_input}")
    endif()
endforeach()
if(GPLATFORM_TARGET_ARCH AND CMAKE_HOST_APPLE)
    string(REGEX REPLACE "^x64$" "x86_64" _requested_arch "${GPLATFORM_TARGET_ARCH}")
    if(CMAKE_OSX_ARCHITECTURES AND NOT CMAKE_OSX_ARCHITECTURES STREQUAL _requested_arch)
        message(FATAL_ERROR "GPLATFORM_TARGET_ARCH conflicts with CMAKE_OSX_ARCHITECTURES.")
    endif()
    set(CMAKE_OSX_ARCHITECTURES "${_requested_arch}" CACHE STRING "Target architecture")
endif()
# Call after project(). Compiler identification is authoritative; VsDevCmd
# variables and the Visual Studio installation directory are not prerequisites.
macro(gplatform_configure_toolchain)
    if(WIN32 AND NOT MSVC)
        message(FATAL_ERROR "Windows builds require MSVC and a matching Qt SDK. Use scripts/build.cmd or an MSVC developer environment.")
    endif()
    set(_compiler_arch "${CMAKE_SYSTEM_PROCESSOR}")
    if(MSVC)
        set(_compiler_arch "${CMAKE_CXX_COMPILER_ARCHITECTURE_ID}")
    elseif(APPLE AND CMAKE_OSX_ARCHITECTURES)
        set(_compiler_arch "${CMAKE_OSX_ARCHITECTURES}")
    endif()
    if(GPLATFORM_TARGET_ARCH)
        string(TOLOWER "${_compiler_arch}" _actual_arch)
        string(TOLOWER "${GPLATFORM_TARGET_ARCH}" _requested_arch)
        string(REGEX REPLACE "^(amd64|x86_64)$" "x64" _actual_arch "${_actual_arch}")
        string(REGEX REPLACE "^(amd64|x86_64)$" "x64" _requested_arch "${_requested_arch}")
        if(NOT _actual_arch STREQUAL _requested_arch)
            message(FATAL_ERROR "GPLATFORM_TARGET_ARCH=${GPLATFORM_TARGET_ARCH} does not match compiler target ${_compiler_arch}. Use a matching compiler and a separate build directory.")
        endif()
    endif()
    include("${_GPLATFORM_BUILD_CMAKE_DIR}/GPlatformMsvcDependencies.cmake")
endmacro()
