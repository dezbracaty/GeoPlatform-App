include_guard(GLOBAL)

# Legacy dependency sub-builds discover the selected compiler and Ninja via the environment.
if(WIN32)
    # NMake recipes need quotes around executable paths containing spaces.
    set(ENV{CC} "\"${CMAKE_C_COMPILER}\"")
    set(ENV{CXX} "\"${CMAKE_CXX_COMPILER}\"")
else()
    set(ENV{CC} "${CMAKE_C_COMPILER}")
    set(ENV{CXX} "${CMAKE_CXX_COMPILER}")
endif()
if(CMAKE_GENERATOR STREQUAL "Ninja")
    get_filename_component(_ninja_bin "${CMAKE_MAKE_PROGRAM}" DIRECTORY)
    if(WIN32)
        set(ENV{PATH} "${_ninja_bin};$ENV{PATH}")
    else()
        set(ENV{PATH} "${_ninja_bin}:$ENV{PATH}")
    endif()
endif()

# The legacy dependency layout separates architectures, but not compilers.
# Reject a different toolchain instead of silently reusing those binaries.
function(gplatform_check_cache_contract build_dir)
    set(_arch "${CMAKE_SYSTEM_PROCESSOR}")
    if(APPLE AND CMAKE_OSX_ARCHITECTURES)
        set(_arch "${CMAKE_OSX_ARCHITECTURES}")
    endif()
    if(_arch MATCHES ";")
        message(FATAL_ERROR "Dependency caches require one architecture per build directory.")
    endif()
    string(TOLOWER "${_arch}" _arch)
    if(WIN32 AND _arch STREQUAL "amd64")
        set(_arch x64)
    endif()
    string(REGEX REPLACE "[^a-z0-9_.-]+" "-" _arch "${_arch}")
    set(_identity "system=${CMAKE_SYSTEM_NAME}\narch=${_arch}\nc=${CMAKE_C_COMPILER_ID}/${CMAKE_C_COMPILER_VERSION}\ncxx=${CMAKE_CXX_COMPILER_ID}/${CMAKE_CXX_COMPILER_VERSION}\nsysroot=${CMAKE_SYSROOT}\nosx_sdk=${CMAKE_OSX_SYSROOT}\nosx_min=${CMAKE_OSX_DEPLOYMENT_TARGET}\n")
    foreach(_abi_input CMAKE_MSVC_RUNTIME_LIBRARY CMAKE_C_COMPILER_TARGET CMAKE_CXX_COMPILER_TARGET)
        if(${_abi_input})
            string(APPEND _identity "${_abi_input}=${${_abi_input}}\n")
        endif()
    endforeach()
    if(CMAKE_TOOLCHAIN_FILE)
        file(SHA256 "${CMAKE_TOOLCHAIN_FILE}" _toolchain_hash)
        string(APPEND _identity "toolchain=${_toolchain_hash}\n")
    endif()
    file(MAKE_DIRECTORY "${build_dir}")
    set(_record "${build_dir}/.gplatform-toolchain.txt")
    file(LOCK "${_record}.lock" GUARD FUNCTION TIMEOUT 30)
    if(EXISTS "${_record}")
        file(READ "${_record}" _previous)
        if(NOT _identity STREQUAL _previous)
            message(FATAL_ERROR "Dependency cache toolchain mismatch: ${_record}\nRecorded:\n${_previous}\nRequested:\n${_identity}\nUse a separate CMAKE_FETCH_CACHE for this toolchain. Existing files were not deleted.")
        endif()
    else()
        # Adopt old caches only after inspecting available compiler metadata.
        file(GLOB _old_compilers "${build_dir}/CMakeFiles/*/CMakeCXXCompiler.cmake")
        foreach(_metadata IN LISTS _old_compilers)
            file(READ "${_metadata}" _content)
            foreach(_field ID VERSION)
                string(REGEX MATCH "set\\(CMAKE_CXX_COMPILER_${_field} \"([^\"]*)\"\\)" _match "${_content}")
                if(_match AND NOT "${CMAKE_MATCH_1}" STREQUAL "${CMAKE_CXX_COMPILER_${_field}}")
                    message(FATAL_ERROR "Existing dependency compiler ${_field} differs in ${_metadata}. Use a separate CMAKE_FETCH_CACHE for this toolchain.")
                endif()
            endforeach()
        endforeach()
        file(WRITE "${_record}" "${_identity}")
        message(STATUS "Recorded dependency toolchain contract: ${_record}")
    endif()
endfunction()
