include_guard(GLOBAL)
if(NOT CMAKE_BUILD_TYPE OR CMAKE_CONFIGURATION_TYPES)
    message(FATAL_ERROR "Select one SDK configuration with -DCMAKE_BUILD_TYPE=Release or Debug")
endif()
set(_sdk_arch "${CMAKE_SYSTEM_PROCESSOR}")
if(CMAKE_OSX_ARCHITECTURES)
    set(_sdk_arch "${CMAKE_OSX_ARCHITECTURES}")
endif()
set(GPLATFORM_SDK_ROOT "${CMAKE_CURRENT_LIST_DIR}/../ThirdParty/libs/GPlatformSDK" CACHE PATH "SDK submodule checkout")
set(_sdk_slot "${GPLATFORM_SDK_ROOT}/${_sdk_arch}/${CMAKE_BUILD_TYPE}")
if(NOT EXISTS "${_sdk_slot}/sdk-build.json")
    message(FATAL_ERROR "SDK is missing: ${_sdk_slot}. Run git submodule update --init --recursive and select a published build configuration.")
endif()
file(GLOB_RECURSE _sdk_archives "${_sdk_slot}/lib/*.a" "${_sdk_slot}/lib/*.lib")
foreach(_archive IN LISTS _sdk_archives)
    file(STRINGS "${_archive}" _first_line LIMIT_COUNT 1 LIMIT_INPUT 100)
    if(_first_line MATCHES "^version https://git-lfs.github.com/spec/")
        message(FATAL_ERROR "SDK contains Git LFS pointers. Install Git LFS and run git lfs pull inside ${GPLATFORM_SDK_ROOT}.")
    endif()
endforeach()
file(READ "${_sdk_slot}/sdk-build.json" _sdk_info)
string(JSON _sdk_system GET "${_sdk_info}" CMAKE_SYSTEM_NAME)
if(NOT _sdk_system STREQUAL CMAKE_SYSTEM_NAME)
    message(FATAL_ERROR "This SDK was built for ${_sdk_system}; consumer uses ${CMAKE_SYSTEM_NAME}")
endif()
string(JSON _sdk_format ERROR_VARIABLE _sdk_format_error GET "${_sdk_info}" SDK_FORMAT)
if(_sdk_format_error OR NOT _sdk_format EQUAL 2)
    message(FATAL_ERROR "This App requires an internal-only SDK (format 2). Build and package the matching SDK in the root project; the previous full SDK cannot be mixed with the fetch provider.")
endif()
if(NOT EXISTS "${_sdk_slot}/lib/cmake/GPlatformSDK/GPlatformSDKConfig.cmake")
    message(FATAL_ERROR "Cannot load GPlatformSDK: package configuration is missing from ${_sdk_slot}")
endif()
string(JSON _sdk_compiler GET "${_sdk_info}" CMAKE_CXX_COMPILER_ID)
string(JSON _sdk_compiler_version GET "${_sdk_info}" CMAKE_CXX_COMPILER_VERSION)
if(NOT "${_sdk_compiler}" STREQUAL "${CMAKE_CXX_COMPILER_ID}")
    message(FATAL_ERROR "SDK compiler ${_sdk_compiler} does not match ${CMAKE_CXX_COMPILER_ID}")
endif()
if(MSVC)
    string(REGEX MATCH "^[0-9]+\\.[0-9]+" _sdk_msvc "${_sdk_compiler_version}")
    string(REGEX MATCH "^[0-9]+\\.[0-9]+" _local_msvc "${CMAKE_CXX_COMPILER_VERSION}")
    if(NOT _sdk_msvc STREQUAL _local_msvc)
        message(FATAL_ERROR "SDK requires the MSVC ${_sdk_msvc} toolset; local compiler is ${CMAKE_CXX_COMPILER_VERSION}")
    endif()
    string(JSON _sdk_runtime GET "${_sdk_info}" CMAKE_MSVC_RUNTIME_LIBRARY)
    if(NOT _sdk_runtime STREQUAL "${CMAKE_MSVC_RUNTIME_LIBRARY}")
        message(FATAL_ERROR "CMAKE_MSVC_RUNTIME_LIBRARY must match the SDK: ${_sdk_runtime}")
    endif()
endif()

# Apply the producer's existing version/feature inputs before fetching anything.
string(JSON _sdk_dependencies GET "${_sdk_info}" DEPENDENCIES)
string(JSON _sdk_dependency_count LENGTH "${_sdk_dependencies}")
math(EXPR _sdk_dependency_last "${_sdk_dependency_count} - 1")
foreach(index RANGE ${_sdk_dependency_last})
    string(JSON key MEMBER "${_sdk_dependencies}" ${index})
    string(JSON expected GET "${_sdk_dependencies}" "${key}")
    if(DEFINED ${key} AND NOT "${${key}}" STREQUAL "${expected}")
        message(FATAL_ERROR "${key}=${${key}} conflicts with the SDK requirement ${expected}. Use matching SDK dependencies.")
    endif()
    set(${key} "${expected}")
endforeach()
string(JSON _sdk_qt_version GET "${_sdk_info}" Qt6_VERSION)
find_package(Qt6 ${_sdk_qt_version} EXACT COMPONENTS Core Gui Qml Quick QuickControls2 Network Quick3D Concurrent Multimedia Widgets OpenGL OpenGLWidgets Sql)
if(NOT Qt6_FOUND)
    message(FATAL_ERROR
        "This SDK requires Qt ${_sdk_qt_version} EXACT: ${Qt6_NOT_FOUND_MESSAGE}\n"
        "Set Qt6_DIR to the directory containing Qt6Config.cmake, or CMAKE_PREFIX_PATH to the Qt installation prefix; an IDE Qt Kit is also supported.\n"
        "Example: cmake --preset release -DQt6_DIR=\"<Qt>/lib/cmake/Qt6\"\n"
        "Use a new build directory when changing Qt installations.")
endif()
string(JSON _sdk_revisions GET "${_sdk_info}" SOURCE_REVISIONS)
set(_app_thirdparty "${CMAKE_CURRENT_LIST_DIR}/../ThirdParty")
if(EXISTS "${_app_thirdparty}/source-revisions.json")
    file(READ "${_app_thirdparty}/source-revisions.json" _file_revisions)
endif()
foreach(fork SmoothUI SmoothUIDock OrcaSlicer SmoothUIDock/KDDockWidgets)
    string(JSON expected GET "${_sdk_revisions}" "${fork}")
    if(EXISTS "${_app_thirdparty}/${fork}/.git")
        find_package(Git REQUIRED)
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${_app_thirdparty}/${fork}" rev-parse HEAD
            OUTPUT_VARIABLE actual OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${_app_thirdparty}/${fork}" status --porcelain --untracked-files=no
            OUTPUT_VARIABLE changes COMMAND_ERROR_IS_FATAL ANY)
        if(changes)
            message(FATAL_ERROR "${fork} has modified tracked inputs. Use the SDK's matching fork sources or rebuild the SDK with the changed dependency.")
        endif()
    elseif(DEFINED _file_revisions)
        string(JSON actual GET "${_file_revisions}" "${fork}")
    else()
        message(FATAL_ERROR "Missing fork provenance for ${fork}. Initialize recorded submodules or use the complete packaged App.")
    endif()
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${fork} revision ${actual} does not match the SDK input ${expected}")
    endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/GPlatformThirdParty.cmake")
# Detect recipes/ABI inputs that disagree after provider resolution as well.
foreach(index RANGE ${_sdk_dependency_last})
    string(JSON key MEMBER "${_sdk_dependencies}" ${index})
    string(JSON expected GET "${_sdk_dependencies}" "${key}")
    if(NOT "${${key}}" STREQUAL "${expected}")
        message(FATAL_ERROR "Provider ${key}=${${key}} does not match the SDK input ${expected}")
    endif()
endforeach()
set(GPlatformSDK_DIR "${_sdk_slot}/lib/cmake/GPlatformSDK" CACHE PATH "Selected SDK package" FORCE)
find_package(GPlatformSDK CONFIG REQUIRED PATHS "${GPlatformSDK_DIR}" NO_DEFAULT_PATH)

function(gplatform_deploy_sdk_runtime target)
    if(APPLE)
        set(destination "$<TARGET_FILE_DIR:${target}>/../Frameworks")
        set_property(TARGET ${target} APPEND PROPERTY BUILD_RPATH "@executable_path/../Frameworks")
        file(GLOB runtime CONFIGURE_DEPENDS "${_sdk_slot}/lib/*.dylib")
    elseif(WIN32)
        set(destination "$<TARGET_FILE_DIR:${target}>")
        file(GLOB runtime CONFIGURE_DEPENDS "${_sdk_slot}/lib/*.dll")
    else()
        set(destination "$<TARGET_FILE_DIR:${target}>")
        file(GLOB runtime CONFIGURE_DEPENDS "${_sdk_slot}/lib/*.so*")
    endif()
    if(runtime)
        set(stamp "${CMAKE_CURRENT_BINARY_DIR}/${target}-sdk-runtime.stamp")
        # One process per library avoids Windows command-line length limits.
        set(copy_commands "")
        foreach(library IN LISTS runtime)
            list(APPEND copy_commands COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${library}" "${destination}")
        endforeach()
        add_custom_command(OUTPUT "${stamp}"
            COMMAND "${CMAKE_COMMAND}" -E make_directory "${destination}"
            ${copy_commands}
            COMMAND "${CMAKE_COMMAND}" -E touch "${stamp}"
            DEPENDS ${runtime} "${_sdk_slot}/sdk-manifest.json"
            COMMAND_EXPAND_LISTS VERBATIM)
        add_custom_target(${target}_sdk_runtime DEPENDS "${stamp}")
        add_dependencies(${target} ${target}_sdk_runtime)
    endif()
endfunction()
