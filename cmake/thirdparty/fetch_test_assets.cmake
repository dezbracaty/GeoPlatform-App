cmake_minimum_required(VERSION 3.24)
include_guard(GLOBAL)

set(_test_assets_repository "dezbracaty/GeoPlatform-TestAssets")
if(CMAKE_SCRIPT_MODE_FILE AND GPLATFORM_TEST_ASSETS_MODE STREQUAL "repository")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "${_test_assets_repository}")
    return()
endif()
set(GPLATFORM_TEST_ASSETS_SHA "" CACHE STRING
    "Complete TestAssets commit SHA for native tests (empty selects the platform branch)")
find_package(Git REQUIRED)

function(_test_assets_error reason)
    if(_stage)
        file(REMOVE_RECURSE "${_stage}")
    endif()
    message(FATAL_ERROR "TestAssets: ${reason}")
endfunction()

function(_test_assets_git out path)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env
        --unset=GIT_DIR --unset=GIT_COMMON_DIR --unset=GIT_WORK_TREE --unset=GIT_INDEX_FILE
        --unset=GIT_OBJECT_DIRECTORY --unset=GIT_ALTERNATE_OBJECT_DIRECTORIES
        GIT_OPTIONAL_LOCKS=0 GIT_LFS_SKIP_SMUDGE=1
        "${GIT_EXECUTABLE}" -C "${path}" ${ARGN}
        RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _error
        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_STRIP_TRAILING_WHITESPACE
        ENCODING UTF-8)
    if(NOT _result STREQUAL "0")
        list(GET ARGN 0 _command)
        _test_assets_error("git ${_command} failed (${_result}): ${_error}")
    endif()
    set(${out} "${_output}" PARENT_SCOPE)
endfunction()

function(_test_assets_file root relative)
    if(IS_ABSOLUTE "${relative}" OR relative MATCHES "(^|/)[.][.](/|$)" OR relative MATCHES "[\\\\]")
        _test_assets_error("Invalid catalog path: ${relative}")
    endif()
    set(_file "${root}/${relative}")
    file(REAL_PATH "${_file}" _real)
    if(NOT EXISTS "${_file}" OR IS_DIRECTORY "${_file}" OR NOT _real STREQUAL _file)
        _test_assets_error("Missing or redirected asset: ${_file}")
    endif()
endfunction()

function(_test_assets_check_files path)
    _test_assets_git(_unused "${path}" lfs fsck --pointers HEAD)
    _test_assets_git(_lfs "${path}" lfs ls-files --json HEAD)
    string(JSON _count LENGTH "${_lfs}" files)
    if(NOT _count)
        _test_assets_error("Checkout contains no Git LFS files: ${path}")
    endif()
    math(EXPR _last "${_count} - 1")
    foreach(_index RANGE 0 ${_last})
        string(JSON _name GET "${_lfs}" files ${_index} name)
        string(JSON _size GET "${_lfs}" files ${_index} size)
        string(JSON _materialized GET "${_lfs}" files ${_index} checkout)
        _test_assets_file("${path}" "${_name}")
        file(SIZE "${path}/${_name}" _actual_size)
        if(NOT _materialized OR NOT _actual_size EQUAL _size)
            _test_assets_error("Git LFS file is not materialized: ${_name} at ${path}")
        endif()
    endforeach()

    _test_assets_file("${path}" catalog.json)
    file(READ "${path}/catalog.json" _catalog)
    string(JSON _schema GET "${_catalog}" schemaVersion)
    string(JSON _scenarios GET "${_catalog}" scenarioRoot)
    string(JSON _count LENGTH "${_catalog}" modelCatalogs)
    if(NOT _schema STREQUAL "1" OR NOT _scenarios STREQUAL "scenarios" OR NOT _count)
        _test_assets_error("Unrecognized catalog: ${path}/catalog.json")
    endif()
    foreach(_key IN ITEMS scenarioSchema baselineManifest)
        string(JSON _file GET "${_catalog}" ${_key})
        _test_assets_file("${path}" "${_file}")
    endforeach()
    math(EXPR _last "${_count} - 1")
    foreach(_index RANGE 0 ${_last})
        string(JSON _file GET "${_catalog}" modelCatalogs ${_index} path)
        _test_assets_file("${path}" "${_file}")
    endforeach()
    foreach(_file IN ITEMS models/basic/editing.json models/imported/printer-preset-switch/111.3mf
                           slicing_regression/cases.json slicing_regression/cases-extended.json)
        _test_assets_file("${path}" "${_file}")
    endforeach()
    file(GLOB _journals "${path}/scenarios/*/events/Journal.json")
    if(NOT _journals)
        _test_assets_error("Checkout contains no active Journal files: ${path}")
    endif()
endfunction()

function(_test_assets_prepare app)
    set(_stage "")
    if(NOT IS_DIRECTORY "${app}" OR IS_SYMLINK "${app}")
        _test_assets_error("Expected an App directory: ${app}")
    endif()
    file(REAL_PATH "${app}" app)
    set(_assets "${app}/tests/TestAssets")
    foreach(_path IN ITEMS "${app}/tests" "${_assets}" "${_assets}/.git")
        set(_real "${_path}")
        if(EXISTS "${_path}")
            file(REAL_PATH "${_path}" _real)
        endif()
        if(IS_SYMLINK "${_path}" OR NOT _real STREQUAL _path)
            _test_assets_error("Refusing a symlink or junction: ${_path}")
        endif()
    endforeach()
    if(EXISTS "${_assets}" AND NOT IS_DIRECTORY "${_assets}")
        _test_assets_error("Expected a checkout directory: ${_assets}")
    endif()

    set(_branch macmini)
    if(WIN32)
        set(_branch windows)
    endif()
    set(_sha "${GPLATFORM_TEST_ASSETS_SHA}")
    if(NOT _sha STREQUAL "")
        string(LENGTH "${_sha}" _length)
        if(NOT _length EQUAL 40 OR NOT _sha MATCHES "^[0-9a-f]+$")
            _test_assets_error("GPLATFORM_TEST_ASSETS_SHA must be a complete lowercase commit SHA")
        endif()
    endif()
    set(_url "https://github.com/${_test_assets_repository}")
    file(GLOB _contents "${_assets}/*")
    if(CMAKE_SCRIPT_MODE_FILE AND GPLATFORM_TEST_ASSETS_MODE STREQUAL "checkout")
        set(_checkout_only TRUE)
        if(NOT _contents)
            _test_assets_error("No existing checkout at ${_assets}")
        endif()
    endif()
    if(_contents)
        set(_marker "${_assets}/.git")
        if(NOT EXISTS "${_marker}")
            _test_assets_error("Refusing an existing directory without a TestAssets checkout: ${_assets}")
        endif()
        _test_assets_git(_top "${_assets}" rev-parse --show-toplevel)
        _test_assets_git(_git_dir "${_assets}" rev-parse --absolute-git-dir)
        _test_assets_git(_common "${_assets}" rev-parse --path-format=absolute --git-common-dir)
        if(NOT IS_DIRECTORY "${_marker}")
            _test_assets_git(_app_top "${app}" rev-parse --show-toplevel)
            _test_assets_git(_app_git_dir "${app}" rev-parse --absolute-git-dir)
            if(NOT _app_top STREQUAL app)
                _test_assets_error("Legacy checkout has no owning App repository: ${_assets}")
            endif()
            set(_marker "${_app_git_dir}/modules/tests/TestAssets")
        endif()
        file(REAL_PATH "${_marker}" _real)
        if(NOT _top STREQUAL _assets OR NOT _git_dir STREQUAL _marker
           OR NOT _common STREQUAL _marker OR NOT _real STREQUAL _marker)
            _test_assets_error("Git directory is outside its expected location: ${_assets}")
        endif()
        _test_assets_git(_origin "${_assets}" config --local --get-all remote.origin.url)
        if(NOT _origin STREQUAL _url AND NOT _origin STREQUAL "${_url}.git"
           AND NOT _origin STREQUAL "git@github.com:${_test_assets_repository}.git"
           AND NOT _origin STREQUAL "ssh://git@github.com/${_test_assets_repository}.git")
            _test_assets_error("Checkout origin does not match ${_test_assets_repository}: ${_assets}")
        endif()
        _test_assets_git(_head "${_assets}" rev-parse "HEAD^{commit}")
        if(_checkout_only)
            message(STATUS "TestAssets: ${_head} at ${_assets}")
            return()
        endif()
        if(_sha STREQUAL "")
            set(_branch_ref "refs/remotes/origin/${_branch}")
            _test_assets_git(_branch_head "${_assets}" for-each-ref "--format=%(refname) %(objectname)" "${_branch_ref}")
            if(NOT _branch_head STREQUAL "${_branch_ref} ${_head}")
                _test_assets_error("Existing checkout ${_assets} at ${_head} cannot be reused for ${_branch}. Save local changes and select that branch explicitly.")
            endif()
        elseif(NOT _sha STREQUAL _head)
            _test_assets_error("Existing checkout ${_assets} is at ${_head}, expected ${_sha}. Save local changes and select that commit explicitly.")
        endif()
        _test_assets_check_files("${_assets}")
    else()
        # Stage the independent shallow checkout beside the final path.
        string(RANDOM LENGTH 16 ALPHABET "0123456789abcdef" _nonce)
        set(_stage "${app}/tests/.test-assets-${_nonce}")
        file(MAKE_DIRECTORY "${_stage}")
        _test_assets_git(_unused "${_stage}" init --quiet)
        _test_assets_git(_unused "${_stage}" remote add origin "${_url}.git")
        _test_assets_git(_unused "${_stage}" lfs install --local --skip-repo)
        set(_ref "${_sha}")
        if(_ref STREQUAL "")
            set(_ref "refs/heads/${_branch}:refs/remotes/origin/${_branch}")
        endif()
        _test_assets_git(_unused "${_stage}" fetch --depth=1 --no-tags --no-recurse-submodules origin "${_ref}")
        _test_assets_git(_head "${_stage}" rev-parse "FETCH_HEAD^{commit}")
        if(NOT _sha STREQUAL "" AND NOT _head STREQUAL _sha)
            _test_assets_error("Fetched ${_head}, expected ${_sha}")
        endif()
        _test_assets_git(_unused "${_stage}" checkout --detach "${_head}")
        _test_assets_git(_unused "${_stage}" lfs pull --include= --exclude= origin)
        _test_assets_check_files("${_stage}")

        # Legacy deinit can leave an empty directory. Moving it aside also
        # permits publishing on Windows, where renaming over it can fail.
        set(_empty "${_stage}-empty")
        if(EXISTS "${_assets}")
            file(GLOB _contents "${_assets}/*")
            if(_contents OR IS_SYMLINK "${_assets}")
                _test_assets_error("Destination changed during preparation: ${_assets}")
            endif()
            file(RENAME "${_assets}" "${_empty}" RESULT _result)
            if(NOT _result STREQUAL "0")
                _test_assets_error("Could not reserve ${_assets}: ${_result}")
            endif()
        endif()
        # Directory renames cannot replace a nonempty checkout.
        file(RENAME "${_stage}" "${_assets}" RESULT _result)
        if(EXISTS "${_empty}")
            file(GLOB _contents "${_empty}/*")
            if(_contents)
                _test_assets_error("Destination changed during preparation. Contents preserved at ${_empty}")
            endif()
            file(REMOVE_RECURSE "${_empty}")
        endif()
        if(NOT _result STREQUAL "0")
            _test_assets_error("Could not publish checkout at ${_assets}: ${_result}")
        endif()
    endif()
    message(STATUS "TestAssets: ${_head} at ${_assets}")
endfunction()

if(CMAKE_SCRIPT_MODE_FILE AND DEFINED GPLATFORM_TEST_ASSETS_APP_DIR)
    _test_assets_prepare("${GPLATFORM_TEST_ASSETS_APP_DIR}")
else()
    _test_assets_prepare("${CMAKE_CURRENT_LIST_DIR}/../..")
endif()
